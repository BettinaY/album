<!DOCTYPE html>
<html lang="zh">
<head>
  <meta charset="UTF-8" />
  <title>我的相册</title>
  <link rel="stylesheet" href="https://unpkg.com/photoswipe@5/dist/photoswipe.css">
  <style>
    body { margin: 0; background: #111; font-family: sans-serif; }
    h1 { text-align: center; color: #fff; padding: 20px; }
    .gallery {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 10px;
      padding: 10px;
    }
    .gallery img {
      width: 100%;
      height: auto;
      cursor: pointer;
      border-radius: 6px;
    }
  </style>
</head>
<body>

<h1>我的相册</h1>

<div class="gallery">
  <!-- 照片列表，复制下面这段替换照片名字即可 -->
  <a href="photos/01.jpg" data-pswp-width="4000" data-pswp-height="3000">
    <img src="photos/01.jpg" />
  </a>
  <a href="photos/02.jpg" data-pswp-width="4000" data-pswp-height="3000">
    <img src="photos/02.jpg" />
  </a>
  <a href="photos/03.jpg" data-pswp-width="4000" data-pswp-height="3000">
    <img src="photos/03.jpg" />
  </a>
  <!-- 如果有更多照片，复制 <a>...</a> 并修改文件名 -->
</div>

<script type="module">
  import PhotoSwipeLightbox from 'https://unpkg.com/photoswipe@5/dist/photoswipe-lightbox.esm.js';
  const lightbox = new PhotoSwipeLightbox({
    gallery: '.gallery',
    children: 'a',
    pswpModule: () => import('https://unpkg.com/photoswipe@5/dist/photoswipe.esm.js')
  });
  lightbox.init();
</script>

</body>
</html>
